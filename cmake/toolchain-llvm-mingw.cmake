# CMake toolchain for llvm-mingw (clang + mingw-w64 ucrt)
set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR AMD64)

set(TOOLCHAIN_ROOT "C:/llvm-mingw-20261117-ucrt-x86_64")
